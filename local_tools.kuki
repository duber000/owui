# local_tools.kuki — built-in sandboxed tools (mini-claude-code mode)
#
# File ops:   stdlib/sandbox (os.Root kernel-level path confinement)
# Net filter: stdlib/netguard (IP allow/block with DNS rebinding protection)
# Shell cmds: stdlib/shell with an explicit command allowlist
#
# Tools exposed to the LLM:
#   read_file, write_file, list_dir, search_files, grep_files, run_command

petiole main

import "os"
import "path/filepath"
import "stdlib/errors" as errs
import "stdlib/json" as jsonpkg
import "stdlib/jsonschema"
import "stdlib/llm/chat"
import "stdlib/netguard"
import "stdlib/sandbox"
import "stdlib/shell"
import "stdlib/slice"
import "stdlib/string" as strpkg

func effectiveCmdAllowList(cfg: Config) list of string
    if cfg.CmdAllowList isnt empty
        return cfg.CmdAllowList
    return defaultCmdAllowList()

func defaultCmdAllowList() list of string
    return list of string{
        "bd",
        "cat",
        "cp",
        "date",
        "diff",
        "echo",
        "find",
        "git",
        "grep",
        "head",
        "ls",
        "mkdir",
        "mv",
        "pwd",
        "rm",
        "sort",
        "tail",
        "touch",
        "uniq",
        "wc",
        "which",
    }

# LocalTool is the closed set of built-in tool names exposed to the LLM.
# The raw values are the wire-format names sent to and received from the LLM.
# ParseLocalTool is used at the dispatch boundary to reject unknown names.
enum LocalTool: string
    ReadFile = "read_file"
    WriteFile = "write_file"
    ListDir = "list_dir"
    SearchFiles = "search_files"
    GrepFiles = "grep_files"
    RunCommand = "run_command"

func allLocalTools() list of LocalTool
    return list of LocalTool{
        LocalTool.ReadFile,
        LocalTool.WriteFile,
        LocalTool.ListDir,
        LocalTool.SearchFiles,
        LocalTool.GrepFiles,
        LocalTool.RunCommand,
    }

# LocalTools holds the sandbox root and optional network guard.
type LocalTools
    Box: sandbox.Root
    Guard: netguard.Guard
    HasGuard: bool
    AllowedCmds: StringSet

# buildLocalTools initialises sandbox + optional netguard from Config.
# Defaults sandbox root to the process CWD when SandboxDir is unset.
func buildLocalTools(cfg: Config) (LocalTools, error)
    lt := LocalTools{AllowedCmds: make(StringSet)}

    sandboxDir := cfg.SandboxDir
    if sandboxDir is empty
        cwd := os.Getwd() onerr explain "sandbox cwd"
        sandboxDir = cwd

    box := sandbox.New(sandboxDir) onerr explain "sandbox"
    lt.Box = box

    if cfg.IPAllowList isnt empty
        g := netguard.NewAllow(cfg.IPAllowList) onerr explain "netguard allow"
        lt.Guard = g
        lt.HasGuard = true
    else if cfg.IPBlockList isnt empty
        g := netguard.NewBlock(cfg.IPBlockList) onerr explain "netguard block"
        lt.Guard = g
        lt.HasGuard = true

    allowed := effectiveCmdAllowList(cfg)
    for cmd in allowed
        lt.AllowedCmds[cmd] = true

    return lt, empty

func closeLocalTools(lt: LocalTools) error
    return lt.Box.Close()

# registerLocalTools attaches built-in tools to an existing Bridge.
func registerLocalTools(b: reference Bridge, cfg: Config) error
    lt := buildLocalTools(cfg)
    b.LocalTools = lt
    b.CmdHint = strpkg.Join(effectiveCmdAllowList(cfg), " ")
    for _, t in allLocalTools()
        b.LocalToolNames[t.String()] = true
    return empty

# ---- Tool registry ----

# toolDef wraps an chat.Tool literal so each registration reads as one line.
func toolDef(name: string, description: string, schema: jsonschema.Object) chat.Tool
    return chat.Tool{
        Type: "function",
        Function: chat.ToolFunction{
            Name: name,
            Description: description,
            Parameters: schema,
        },
    }

func localToolDefs(cmdHint: string) list of chat.Tool
    if cmdHint is empty
        cmdHint = strpkg.Join(defaultCmdAllowList(), " ")

    readSchema := jsonschema.Schema(list of jsonschema.Property{
        jsonschema.Prop("path", jsonschema.String, "File path relative to sandbox root"),
    })
        |> jsonschema.Required(list of string{"path"})

    writeSchema := jsonschema.Schema(list of jsonschema.Property{
        jsonschema.Prop("path", jsonschema.String, "File path relative to sandbox root"),
        jsonschema.Prop("content", jsonschema.String, "Content to write"),
    })
        |> jsonschema.Required(list of string{"path", "content"})

    listSchema := jsonschema.Schema(list of jsonschema.Property{
        jsonschema.Prop(
            "path",
            jsonschema.String,
            "Directory path relative to sandbox root (default: .)",
        ),
    })

    searchSchema := jsonschema.Schema(list of jsonschema.Property{
        jsonschema.Prop("pattern", jsonschema.String, "File name glob pattern (e.g. *.go, main.*)"),
    })
        |> jsonschema.Required(list of string{"pattern"})

    grepSchema := jsonschema.Schema(list of jsonschema.Property{
        jsonschema.Prop("pattern", jsonschema.String, "Regex or literal text to search for"),
        jsonschema.Prop("path", jsonschema.String, "Path within sandbox to search (default: .)"),
    })
        |> jsonschema.Required(list of string{"pattern"})

    # run_command has an array-typed `args` property — llm.Schema only
    # expresses scalar types today, so build this one by hand.
    runProps := jsonschema.Object{
        "cmd": jsonschema.Object{
            "type": "string",
            "description": "Command name — allowed: {cmdHint}",
        },
        "args": jsonschema.Object{
            "type": "array",
            "items": jsonschema.Object{"type": "string"},
            "description": "Command arguments",
        },
    }
    runSchema := jsonschema.Object{
        "type": "object",
        "properties": runProps,
        "required": list of string{"cmd"},
    }

    return list of chat.Tool{
        toolDef(
            LocalTool.ReadFile.String(),
            "Read the contents of a file within the sandbox",
            readSchema,
        ),
        toolDef(
            LocalTool.WriteFile.String(),
            "Write or overwrite a file within the sandbox",
            writeSchema,
        ),
        toolDef(
            LocalTool.ListDir.String(),
            "List files and directories within a sandbox directory",
            listSchema,
        ),
        toolDef(
            LocalTool.SearchFiles.String(),
            "Search for files matching a name pattern within the sandbox",
            searchSchema,
        ),
        toolDef(
            LocalTool.GrepFiles.String(),
            "Search file contents for a pattern within the sandbox",
            grepSchema,
        ),
        toolDef(
            LocalTool.RunCommand.String(),
            "Run an allowlisted shell command in the sandbox directory",
            runSchema,
        ),
    }

# ---- Tool calls (variant enum) ----

# LocalToolCall is the parsed, typed form of an LLM tool invocation. The
# JSON-arg decode happens once in parseLocalToolCall; downstream handlers
# receive validated, typed payloads. Adding a new tool variant here makes
# the dispatch switch a compile error until every site handles it.
enum LocalToolCall
    ReadFile
        path: string
    WriteFile
        path: string
        content: string
    ListDir
        path: string
    SearchFiles
        pattern: string
    GrepFiles
        pattern: string
        path: string
    RunCommand
        cmd: string
        args: list of string

# JSON-decode targets — kept private; they exist only to carry the wire
# format's tags into the LocalToolCall constructor.
type readFileArgs
    Path: string as "path"

type writeFileArgs
    Path: string as "path"
    Content: string as "content"

type listDirArgs
    Path: string as "path"

type searchFilesArgs
    Pattern: string as "pattern"

type grepFilesArgs
    Pattern: string as "pattern"
    Path: string as "path"

type runCommandArgs
    Cmd: string as "cmd"
    Args: list of string as "args"

# parseLocalToolCall resolves the tool name and decodes its argument JSON
# in one step. Missing-required-field validation lives here so handlers
# see only well-formed inputs.
func parseLocalToolCall(name: string, argsJSON: string) (LocalToolCall, error)
    tool := ParseLocalTool(name) onerr
        return ReadFile{}, error "unknown local tool: {name}"

    switch tool
        when LocalTool.ReadFile
            a := jsonpkg.Parse of readFileArgs from argsJSON onerr return ReadFile{}, errs.Wrapf(error, "read_file: bad args")
            if a.Path is empty
                return ReadFile{}, error "read_file: missing path"
            return ReadFile{path: a.Path}, empty
        when LocalTool.WriteFile
            a := jsonpkg.Parse of writeFileArgs from argsJSON onerr return ReadFile{}, errs.Wrapf(error, "write_file: bad args")
            if a.Path is empty
                return ReadFile{}, error "write_file: missing path"
            # Reject a missing `content` rather than silently truncating the
            # target file to zero bytes. An explicit "" is still allowed.
            m := jsonpkg.Parse of map of string to any from argsJSON onerr return ReadFile{}, errs.Wrapf(error, "write_file: bad args")
            _, hasContent := m["content"]
            if not hasContent
                return ReadFile{}, error "write_file: missing content"
            return WriteFile{path: a.Path, content: a.Content}, empty
        when LocalTool.ListDir
            # list_dir tolerates empty argsJSON — defaults to "."
            a := listDirArgs{}
            if argsJSON isnt empty and argsJSON isnt "{}"
                a = jsonpkg.Parse of listDirArgs from argsJSON onerr return ReadFile{}, errs.Wrapf(error, "list_dir: bad args")
            path := a.Path
            if path is empty
                path = "."
            return ListDir{path: path}, empty
        when LocalTool.SearchFiles
            a := jsonpkg.Parse of searchFilesArgs from argsJSON onerr return ReadFile{}, errs.Wrapf(error, "search_files: bad args")
            if a.Pattern is empty
                return ReadFile{}, error "search_files: missing pattern"
            return SearchFiles{pattern: a.Pattern}, empty
        when LocalTool.GrepFiles
            a := jsonpkg.Parse of grepFilesArgs from argsJSON onerr return ReadFile{}, errs.Wrapf(error, "grep_files: bad args")
            if a.Pattern is empty
                return ReadFile{}, error "grep_files: missing pattern"
            searchPath := a.Path
            if searchPath is empty
                searchPath = "."
            return GrepFiles{pattern: a.Pattern, path: searchPath}, empty
        when LocalTool.RunCommand
            a := jsonpkg.Parse of runCommandArgs from argsJSON onerr return ReadFile{}, errs.Wrapf(error, "run_command: bad args")
            if a.Cmd is empty
                return ReadFile{}, error "run_command: missing cmd"
            return RunCommand{cmd: a.Cmd, args: a.Args}, empty
    return ReadFile{}, error "unreachable local tool: {name}"

# ---- Tool dispatch ----

func dispatchLocalTool(lt: LocalTools, name: string, argsJSON: string) (string, error)
    call, err := parseLocalToolCall(name, argsJSON)
    if err isnt empty
        return "", err
    switch call
        when ReadFile
            return localReadFile(lt, call.path)
        when WriteFile
            return localWriteFile(lt, call.path, call.content)
        when ListDir
            return localListDir(lt, call.path)
        when SearchFiles
            return localSearchFiles(lt, call.pattern)
        when GrepFiles
            return localGrepFiles(lt, call.pattern, call.path)
        when RunCommand
            return localRunCommand(lt, call.cmd, call.args)

# ---- Implementations ----

func localReadFile(lt: LocalTools, path: string) (string, error)
    content := lt.Box.ReadString(path) onerr explain "read_file"
    return content, empty

func localWriteFile(lt: LocalTools, path: string, content: string) (string, error)
    lt.Box.WriteString(content, path) onerr explain "write_file"
    return "wrote {len(content)} bytes to {path}", empty

func localListDir(lt: LocalTools, path: string) (string, error)
    names := lt.Box.List(path) onerr explain "list_dir"
    if names is empty
        return "(empty)", empty
    return strpkg.Join(names, "\n"), empty

func localSearchFiles(lt: LocalTools, pattern: string) (string, error)
    sandboxPath := lt.Box.Path
    out := shell.New("find", sandboxPath)
        |> .Flag("-name", pattern)
        |> .Execute()
    if out is shell.Succeeded as ok
        return formatRelativeMatches(ok.Stdout as string, sandboxPath), empty
    if out is shell.Failed as fail
        if strpkg.TrimSpace(fail.Error.Stdout as string) isnt empty
            # Partial results (e.g. some directories unreadable) — still useful.
            return formatRelativeMatches(fail.Error.Stdout as string, sandboxPath), empty
        stderr := strpkg.TrimSpace(fail.Error.Stderr as string)
        if stderr is empty
            stderr = "find exited {fail.Error.ExitCode}"
        return "", error "search_files: {stderr}"
    return "", error "search_files: unexpected shell result"

func localGrepFiles(lt: LocalTools, pattern: string, searchPath: string) (string, error)
    sandboxPath := lt.Box.Path
    fullPath := filepath.Join(sandboxPath, searchPath)
    rel := filepath.Rel(sandboxPath, fullPath) onerr return "", error "grep_files: invalid path"
    # rel == ".." or a leading "../" means the target escaped the sandbox.
    # A plain HasPrefix("..") would also reject legitimate names like "..hidden".
    if rel equals ".." or strpkg.HasPrefix(rel, "../")
        return "", error "grep_files: path escapes sandbox"
    # -e keeps a leading-dash pattern from being parsed as grep flags;
    # -I skips binary files; exit 1 means "no matches", exit >= 2 is an error.
    out := shell.New("grep", "-r", "-n", "-I", "-e", pattern, "--", fullPath) |> .Execute()
    if out is shell.Succeeded as ok
        return formatRelativeMatches(ok.Stdout as string, sandboxPath), empty
    if out is shell.Failed as fail
        if fail.Error.ExitCode equals 1
            return "(no matches)", empty
        stderr := strpkg.TrimSpace(fail.Error.Stderr as string)
        if stderr is empty
            stderr = "grep exited {fail.Error.ExitCode}"
        return "", error "grep_files: {stderr}"
    return "", error "grep_files: unexpected shell result"

# argWithinSandbox reports whether a command argument resolves to a path
# inside the sandbox. Absolute paths must be within the sandbox root;
# relative paths must not escape it. Non-path arguments (numbers, flags,
# globs, regexes) pass through — only values that resolve outside are
# rejected. Note: this confines path-like arguments; it is not a VM
# boundary (allowlisted binaries can still run subcommands, e.g. git).
func argWithinSandbox(sandboxPath: string, arg: string) bool
    if arg is empty
        return true
    base := filepath.Clean(sandboxPath)
    if base equals "/"
        return true
    full := filepath.Clean(arg)
    if not filepath.IsAbs(arg)
        full = filepath.Join(base, arg)
    if full equals base
        return true
    return strpkg.HasPrefix(full, base + "/")

# formatRelativeMatches trims the sandbox prefix from each non-empty line of `stdout`
# so paths shown to the LLM are sandbox-relative, not absolute.
func formatRelativeMatches(stdout: string, sandboxPath: string) string
    raw := strpkg.TrimSpace(stdout)
    if raw is empty
        return "(no matches)"
    prefix := sandboxPath + "/"
    matches := strpkg.Split(raw, "\n")
        |> slice.Filter(l => l isnt empty)
        |> slice.Map(l => strpkg.TrimPrefix(l, prefix))
    return strpkg.Join(matches, "\n")

func localRunCommand(lt: LocalTools, cmd: string, args: list of string) (string, error)
    if not lt.AllowedCmds[cmd]
        return "", error "run_command: '{cmd}' is not in the allowed command list"
    sandboxPath := lt.Box.Path
    # Confine path-like arguments to the sandbox: reject absolute paths
    # outside it and relative paths that escape it (e.g. "../..").
    for _, arg in args
        if not argWithinSandbox(sandboxPath, arg)
            return "", error "run_command: argument '{arg}' escapes the sandbox"
    out := shell.New(cmd, many args) |> .Dir(sandboxPath) |> .Execute()
    stdout := ""
    stderr := ""
    exitCode := 0
    if out is shell.Succeeded as ok
        stdout = ok.Stdout as string
        stderr = ok.Stderr as string
    else if out is shell.Failed as fail
        stdout = fail.Error.Stdout as string
        stderr = fail.Error.Stderr as string
        exitCode = fail.Error.ExitCode
    stdout = strpkg.TrimSpace(stdout)
    stderr = strpkg.TrimSpace(stderr)
    combined := stdout
    if stderr isnt empty
        combined = if combined isnt empty then "{combined}\n[stderr]\n{stderr}" else "[stderr]\n{stderr}"
    if combined is empty
        combined = "(no output)"
    if not shell.Success(out)
        return combined, error "exited {exitCode}"
    return combined, empty
