# Bridge — MCP client that discovers tools and dispatches tool calls
# Connects to multiple MCP servers via streamable HTTP transport
# Converts between MCP tool format and stdlib/llm/chat tool format

petiole main

import "context"
import "stdlib/cli"
import "stdlib/color"
import "stdlib/json" as jsonpkg
import "stdlib/jsonschema"
import "stdlib/llm/chat"
import "stdlib/maps"
import "stdlib/mcp"
import "stdlib/regex"
import "stdlib/slice"

# sanitizeName keeps [a-zA-Z0-9_-] only, replacing everything else with an
# underscore, because OpenAI's function-calling schema rejects other
# characters — many MCP servers expose tool names with `/`, `.`, `:`, or spaces.
var sanitizeRe = regex.MustCompile('[^a-zA-Z0-9_-]')

type ToolRoute
    ServerName: string
    OriginalName: string

type BridgeServer
    Name: string
    URL: string
    Session: reference mcp.ClientSession
    Tools: list of mcp.ClientTool

type Bridge
    Servers: list of reference BridgeServer
    ToolMap: map of string to ToolRoute
    LocalTools: LocalTools
    LocalToolNames: StringSet
    # Failed records per-server connect/discovery failures so `owui health`
    # can report them (connectBridges itself only warns and continues).
    Failed: MCPFailures
    # CmdHint is the allowlist description shown to the LLM in the
    # run_command tool schema — the effective list, not the built-in default.
    CmdHint: string

type MCPFailures = map of string to error

func connectBridges(ctx: context.Context, configs: MCPServers) (reference Bridge, error)
    b := reference of Bridge{
        Servers: empty list of reference BridgeServer,
        ToolMap: empty map of string to ToolRoute,
        LocalToolNames: make(StringSet),
        Failed: make(MCPFailures),
    }

    # Iterate servers in sorted order — map iteration order is random, and
    # an unstable tool ordering churns every request's prompt.
    for _, name in sortedMCPNames(configs)
        cfg := configs[name]
        if cfg.Disabled
            continue

        session := connectOne(ctx, cfg) onerr
            b.Failed[name] = error
            cli.Error(color.Dim("warning: MCP {name} ({cfg.URL}) connect failed: {error}"))
            continue

        server := reference of BridgeServer{Name: name, URL: cfg.URL, Session: session}

        # Refresh tools for this server
        tools := mcp.ListTools(ctx, session) onerr
            b.Failed[name] = error
            cli.Error(color.Dim("warning: MCP {name} ({cfg.URL}) list tools failed: {error}"))
            mcp.Close(session)
            continue

        server.Tools = tools
        b.Servers = append(b.Servers, server)

        # Map prefixed names to this server. Local (built-in) tools and
        # earlier servers win name collisions; losers are skipped with a
        # warning instead of silently shadowing a tool.
        for _, t in tools
            prefixed := prefixedToolName(name, t.Name)
            if isLocalToolName(prefixed)
                cli.Error(color.Dim(
                    "warning: MCP {name} tool '{t.Name}' collides with built-in tool '{prefixed}' — skipping",
                ))
                continue
            existing, taken := b.ToolMap[prefixed]
            if taken
                cli.Error(color.Dim(
                    "warning: MCP tool '{prefixed}' ({name}/{t.Name}) collides with {existing.ServerName}/{existing.OriginalName} — skipping",
                ))
                continue
            b.ToolMap[prefixed] = ToolRoute{ServerName: name, OriginalName: t.Name}

    return b, empty

func connectOne(ctx: context.Context, cfg: MCPServerConfig) (reference mcp.ClientSession, error)
    if cfg.APIKey isnt empty
        return mcp.BearerConnect(ctx, cfg.URL, cfg.APIKey)

    return mcp.Connect(ctx, cfg.URL)

func closeBridges(b: reference Bridge) error
    for _, s in b.Servers
        mcp.Close(s.Session)
    if b.LocalToolNames isnt empty
        closeLocalTools(b.LocalTools) onerr return error
    return empty

# sortedMCPNames returns the MCP server names in sorted order so connect
# order (and therefore tool order) is deterministic across runs.
func sortedMCPNames(m: MCPServers) list of string
    return maps.SortedKeys(m)

# prefixedToolName builds the wire-format tool name sent to the LLM:
# "<server>_<tool>", both parts sanitized to [a-zA-Z0-9_-] and the result
# capped at 64 characters (OpenAI's function-name limit).
func prefixedToolName(server: string, tool: string) string
    s := sanitizeName(server)
    t := sanitizeName(tool)
    prefixed := "{s}_{t}"
    if len(prefixed) <= 64
        return prefixed
    budget := 64 - len(s) - 1
    if budget < 16
        s = s[:32]
        budget = 64 - len(s) - 1
    return "{s}_{t[:budget]}"

# isLocalToolName reports whether name is one of the built-in tool names.
func isLocalToolName(name: string) bool
    for _, t in allLocalTools()
        if t.String() equals name
            return true
    return false

# bridgeTools returns all tools — built-in local tools first, then
# MCP-discovered. Names that collide with a built-in or an earlier server's
# tool are skipped (first wins), matching how connectBridges builds ToolMap.
func bridgeTools(b: reference Bridge) list of chat.Tool
    tools := make(list of chat.Tool, 0, len(b.ToolMap) + len(b.LocalToolNames))

    if b.LocalToolNames isnt empty
        tools = append(tools, many localToolDefs(b.CmdHint))

    seen := make(StringSet)
    for _, t in allLocalTools()
        seen[t.String()] = true
    for _, s in b.Servers
        for _, t in s.Tools
            prefixed := prefixedToolName(s.Name, t.Name)
            if seen[prefixed]
                continue
            seen[prefixed] = true
            tools = append(tools, chat.Tool{
                Type: "function",
                Function: chat.ToolFunction{
                    Name: prefixed,
                    Description: "({s.Name}) {t.Description}",
                    Parameters: t.InputSchema,
                },
            })

    return tools

func bridgeToolCount(b: reference Bridge) int
    serverCounts := b.Servers |> slice.Map(s => len(s.Tools))
    return len(b.LocalToolNames) + slice.Sum(serverCounts)

# callBridgeTool dispatches a tool call — built-in tools first, then MCP servers.
func callBridgeTool(ctx: context.Context, b: reference Bridge, name: string, argsJSON: string) (string, error)
    if b.LocalToolNames[name]
        return dispatchLocalTool(b.LocalTools, name, argsJSON)

    route, ok := b.ToolMap[name]
    if not ok
        return "", error "unknown tool: {name}"

    server := findServer(b, route.ServerName)
    if server equals empty
        return "", error "server {route.ServerName} not connected"

    return invokeMCPTool(ctx, server, route.OriginalName, argsJSON)

func findServer(b: reference Bridge, name: string) reference BridgeServer
    for _, s in b.Servers
        if s.Name equals name
            return s
    return empty

func invokeMCPTool(ctx: context.Context, s: reference BridgeServer, name: string, argsJSON: string) (string, error)
    args := empty map of string to any
    if argsJSON isnt empty and argsJSON isnt "{}"
        args = jsonpkg.Parse of jsonschema.Object from argsJSON onerr explain "invalid tool arguments"

    result := mcp.CallTool(ctx, s.Session, name, args) onerr return "", error

    if result.IsError
        return "ERROR: {result.Text}", empty

    return result.Text, empty

# sanitizeName replaces hyphens/slashes/spaces with underscores because
# OpenAI's function-calling schema only accepts [a-zA-Z0-9_-] (effectively
# underscores in our case) — many MCP servers expose tool names with `/` or ` `.
func sanitizeName(name: string) string
    return sanitizeRe.Replace(name, "_")
