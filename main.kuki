# owui — CLI agent: Open WebUI + Open Terminal via MCP
# Dispatches subcommands manually since the root command accepts
# arbitrary args as a prompt (models/tools/health/configure/version
# are subcommands, everything else is treated as a prompt)

petiole main

import "context"
import "fmt"
import "io"
import "os"
import "stdlib/cli"
import "stdlib/color"
import "stdlib/fetch"
import "stdlib/files"
import "stdlib/input"
import "stdlib/json" as jsonpkg
import "stdlib/llm/chat"
import "stdlib/string" as strpkg

var version: string = "dev"

# ---- Entrypoint ----

func main()
    flagParser := cli.New("owui")
        |> cli.StringFlag("model", "Model to use", "")
        |> cli.Short("m")
        |> cli.BoolFlag("chat", "Interactive chat mode", false)
        |> cli.Short("c")
        |> cli.BoolFlag("raw", "Raw output (no streaming indicators)", false)
        |> cli.BoolFlag(
            "tools",
            "Always print tool indicators to stderr, even when stdout is not a terminal (headless callers like foamy)",
            false,
        )
        |> cli.StringFlag("system", "System prompt override", "")
        |> cli.Short("S")
        |> cli.BoolFlag("schema", "Show tool schemas", false)
        |> cli.RestArg("args", "Positional arguments / prompt")

    parsed := cli.ParseArgs(flagParser, os.Args)

    flagModel := cli.GetString(parsed, "model")
    flagChat := cli.GetBool(parsed, "chat")
    flagRaw := cli.GetBool(parsed, "raw")
    flagTools := cli.GetBool(parsed, "tools")
    flagSystem := cli.GetString(parsed, "system")
    flagSchema := cli.GetBool(parsed, "schema")
    positional := cli.GetRest(parsed, "args")

    # Dispatch subcommands; anything else falls through to agent mode
    if len(positional) > 0
        handled, err := dispatchSubcommand(positional[0], flagSchema)
        if handled
            if err isnt empty
                cli.Fatal(color.BrightRed("error: {err}"))
            return

    # Default: agent mode
    cmdRun(positional, flagModel, flagChat, flagRaw, flagTools, flagSystem) onerr
        cli.Fatal(color.BrightRed("error: {error}"))

enum Subcommand: string
    Models = "models"
    Tools = "tools"
    Health = "health"
    Configure = "configure"
    Version = "version"

func dispatchSubcommand(cmd: string, flagSchema: bool) (bool, error)
    sub := ParseSubcommand(cmd) onerr return false, empty
    switch sub
        when Subcommand.Models
            return true, cmdListModels()
        when Subcommand.Tools
            return true, cmdListTools(flagSchema)
        when Subcommand.Health
            return true, cmdHealth()
        when Subcommand.Configure
            return true, cmdConfigure()
        when Subcommand.Version
            print("owui {version}")
            return true, empty
    return false, empty

# ---- Agent mode ----

func cmdRun(positional: list of string, flagModel: string, flagChat: bool, flagRaw: bool, flagTools: bool, flagSystem: string) error
    cfg := loadConfig()
    if flagModel isnt ""
        cfg.Model = flagModel
    validateConfig(cfg) onerr return

    ctx := context.Background()

    a := buildAgent(ctx, cfg, flagSystem)
    defer closeBridges(a.Bridge)

    prompt := gatherPrompt(positional)

    if flagChat
        runChat(ctx, a, prompt)
        return empty

    if prompt equals ""
        return error "no prompt provided — use -c for interactive chat"

    return runOneShot(ctx, a, prompt, flagRaw, flagTools)

func buildAgent(ctx: context.Context, cfg: Config, flagSystem: string) (reference Agent, error)
    bridge := connectBridges(ctx, cfg.MCPServers) onerr return empty, error "connecting to MCP servers: {error}"

    if cfg.BuiltInTools
        registerLocalTools(bridge, cfg) onerr
            cli.Error(color.Dim("warning: local tools unavailable: {error}"))

    if isTTYErr()
        sandboxLabel := if cfg.SandboxDir isnt "" then cfg.SandboxDir else "cwd"
        cli.Error(
            "{color.Dim("tools:")} {color.Dim("{bridgeToolCount(bridge)} available | sandbox: {sandboxLabel}")}",
        )

    a := reference of Agent{Bridge: bridge, Config: cfg, MaxRounds: cfg.MaxToolRounds}

    if flagSystem isnt ""
        a.SystemPrompt = flagSystem

    # Load AGENTS.md from cwd if present — gives the LLM project context
    agentsDoc := files.ReadString("AGENTS.md") onerr ""
    if agentsDoc isnt ""
        base := a.SystemPrompt
        if base equals ""
            base = defaultSystemPrompt
        a.SystemPrompt = "{base}\n\n# Project Context (AGENTS.md)\n\n{agentsDoc}"
        if isTTYErr()
            cli.Error(color.Dim("Loaded AGENTS.md from current directory"))

    return a, empty

func runOneShot(ctx: context.Context, a: reference Agent, prompt: string, flagRaw: bool, flagTools: bool) error
    isTTY := isTTYOut()

    # Tool indicators go to stderr. Interactive runs print them whenever
    # stdout is a terminal; --tools forces them unconditionally so
    # headless callers (foamy's /steep heartbeat) can parse a live status
    # out of the pipe.
    if isTTY or flagTools
        setToolCallbacks(a, "", 80, 120)

    a.OnText = func(chunk: string)
        if isTTY and not flagRaw
            fmt.Print(chunk) onerr discard

    # Reasoning models (e.g. Qwen3.6, glm-5.2) emit thinking tokens before
    # the final answer. Surface them on stderr so the user sees activity
    # instead of an apparent hang, without polluting stdout for pipes.
    if isTTY or flagTools
        a.OnThinking = func(chunk: string)
            cli.Error(color.Dim(chunk))

    result := runAgent(ctx, a, prompt, empty list of chat.Message) onerr return

    if isTTY and not flagRaw
        print("")
    else
        fmt.Print(result.Content) onerr discard

    if isTTY or flagTools
        cli.Error(color.Dim("({result.Rounds} tool rounds)"))

    return empty

# ---- Subcommands ----

type ModelEntry
    ID: string as "id"
    Name: string as "name"

type ModelsResponse
    Data: list of ModelEntry as "data"

func cmdListModels() error
    cfg := loadConfig()
    if resolveAPIKey(cfg) equals ""
        return error "LLM API key required"

    url := "{resolveBaseURL(cfg)}{resolveModelsPath(cfg)}"
    resp := fetch.New(url)
        |> fetch.BearerAuth(resolveAPIKey(cfg))
        |> fetch.Retry(3, 500)
        |> fetch.Do()

    if resp.StatusCode isnt 200
        body := fetch.Bytes(resp) onerr return error "HTTP {resp.StatusCode}"
        return error "HTTP {resp.StatusCode}: {body as string}"

    models := ModelsResponse{}
    resp.Decode(reference of models)

    print(color.Bold(color.Cyan("Available models:")))
    for _, m in models.Data
        name := m.Name
        if name equals ""
            name = m.ID
        print("  {name} {color.Dim("({m.ID})")}")

    return empty

func cmdListTools(showSchema: bool) error
    cfg := loadConfig()
    ctx := context.Background()

    bridge := connectBridges(ctx, cfg.MCPServers) onerr return
    defer closeBridges(bridge)

    if cfg.BuiltInTools
        registerLocalTools(bridge, cfg) onerr return

    print(color.Bold(color.Yellow("Available tools:")))
    for _, t in bridgeTools(bridge)
        print("  {t.Function.Name}")
        if showSchema
            b := jsonpkg.PrettyBytes(t.Function.Parameters) onerr
                fallback empty list of byte

            print("    {b as string}")

    return empty

func cmdHealth() error
    cfg := loadConfig()
    ctx := context.Background()

    # LLM endpoint
    baseURL := resolveBaseURL(cfg)
    fmt.Print("LLM  ({baseURL})  ") onerr discard
    apiKey := resolveAPIKey(cfg)
    url := "{baseURL}{resolveModelsPath(cfg)}"
    # Ollama and custom providers may run without an API key — probe the
    # models endpoint without auth rather than reporting "no API key".
    req := fetch.New(url)
    if apiKey isnt ""
        req = fetch.BearerAuth(req, apiKey)
    req = fetch.Retry(req, 3, 500)
    resp, err := fetch.Do(req)

    if err isnt empty
        print("{color.BrightRed("x")} {err}")
    else
        resp.Close()
        if resp.StatusCode equals 200
            print(color.Green("ok"))
        else
            print("{color.BrightRed("x")} HTTP {resp.StatusCode}")

    # MCP Servers
    for name, mcfg in cfg.MCPServers
        fmt.Print("{name} MCP ({mcfg.URL})  ") onerr discard
        if mcfg.Disabled
            print(color.Dim("disabled"))
            continue

        m := make(MCPServers)
        m[name] = mcfg
        bridge, err := connectBridges(ctx, m)
        if err isnt empty
            print("{color.BrightRed("x")} {err}")
        else
            print("{color.Green("ok")} {bridgeToolCount(bridge)} tools")
            closeBridges(bridge)

    return empty

func cmdConfigure() error
    cfg := loadConfig()

    f := input.NewForm()
    f.Text("provider", "Provider [openwebui|hetzner|openai|ollama|custom] [{cfg.Provider}]: ")
    f.Default("provider", cfg.Provider)
    f.Text("baseURL", "LLM base URL [{resolveBaseURL(cfg)}]: ")
    f.Default("baseURL", resolveBaseURL(cfg))
    f.Text("apiKey", "LLM API Key [{maskKey(resolveAPIKey(cfg))}]: ")
    f.Default("apiKey", resolveAPIKey(cfg))
    f.Text("model", "Model [{cfg.Model}]: ")
    f.Default("model", cfg.Model)
    f.Text("mcpURL", "terminal MCP URL [{cfg.TerminalMCPURL}]: ")
    f.Default("mcpURL", cfg.TerminalMCPURL)
    f.Text("mcpKey", "terminal MCP API Key [{maskKey(cfg.TerminalMCPAPIKey)}]: ")
    f.Default("mcpKey", cfg.TerminalMCPAPIKey)
    f.Text("sandbox", "Sandbox directory [{cfg.SandboxDir}]: ")
    f.Default("sandbox", cfg.SandboxDir)

    f.Run()

    cfg.Provider = f.String("provider")
    cfg.LLMBaseURL = f.String("baseURL")
    cfg.LLMAPIKey = f.String("apiKey")
    cfg.Model = f.String("model")
    cfg.TerminalMCPURL = f.String("mcpURL")
    cfg.TerminalMCPAPIKey = f.String("mcpKey")
    cfg.SandboxDir = f.String("sandbox")

    saveConfig(cfg) onerr return
    print(color.Green("Saved to {defaultConfigPath()}"))
    return empty

# ---- Interactive chat (simple readline loop) ----

func runChat(ctx: context.Context, a: reference Agent, initialPrompt: string)
    history := empty list of chat.Message
    prompt := initialPrompt

    print(color.Dim("owui chat — model: {a.Config.Model} — type 'exit' to quit"))
    print("")

    for true
        if prompt equals ""
            prompt = input.ReadLine(color.Bold(color.Cyan("you> "))) onerr
                break

            if prompt equals "exit" or prompt equals "quit"
                break
            if prompt equals ""
                continue

        setToolCallbacks(a, "  ", 60, 80)

        # Stream response chunks; print the model prefix lazily on the first
        # chunk so tool-call output (stderr) appears before the response line.
        # Thinking tokens (reasoning models) go to stderr dimmed so the
        # terminal shows activity during long thinking phases.
        firstChunk := true
        a.OnThinking = func(chunk: string)
            cli.Error(color.Dim(chunk))

        a.OnText = func(chunk: string)
            if firstChunk
                fmt.Print("\n{color.Dim(a.Config.Model)}  ") onerr discard
                firstChunk = false
            fmt.Print(chunk) onerr discard

        result := runAgent(ctx, a, prompt, history) onerr
            print(color.BrightRed("error: {error}"))
            print("")
            prompt = ""
            continue

        if firstChunk and result.Content isnt ""
            # Streaming produced no chunks (e.g. buffered response) — print normally.
            print("\n{color.Dim(a.Config.Model)}  {result.Content}")
        else
            print("")
        if result.Rounds > 1
            print(color.Dim("  ({result.Rounds} rounds)"))
        print("")

        history = result.Messages
        prompt = ""

# ---- Helpers ----

func gatherPrompt(args: list of string) string
    prompt := ""

    # Simple heuristic: assume not a terminal if TERM is empty and no args
    if not isTerminal(os.Stdin) and len(args) equals 0
        data := io.ReadAll(os.Stdin) onerr
            fallback empty list of byte

        prompt = strpkg.TrimSpace(data as string)

    if len(args) > 0
        argText := strpkg.Join(args, " ")
        if prompt isnt ""
            prompt = "{argText}\n\n{prompt}"
        else
            prompt = argText

    return prompt

func isTerminal(f: reference os.File) bool
    info, err := f.Stat()
    if err isnt empty
        return false
    # 0x200000 is os.ModeCharDevice (1<<21) — set when the fd is a character
    # device (i.e. a terminal), unset for pipes/files/sockets.
    return (info.Mode() & 0x200000) isnt 0

func isTTYOut() bool
    return isTerminal(os.Stdout)

func isTTYErr() bool
    return isTerminal(os.Stderr)

func maskKey(k: string) string
    if len(k) < 8
        return "--------"
    return "{k[:4]}...{k[len(k) - 4:]}"

func setToolCallbacks(a: reference Agent, indent: string, argsWidth: int, resultWidth: int)
    a.OnToolCall = func(name: string, toolArgs: string)
        cli.Error(
            "{indent}{color.Yellow("-> {name}")} {color.Dim(strpkg.Truncate(toolArgs, argsWidth))}",
        )

    a.OnToolResult = func(name: string, result: string)
        cli.Error(
            "{indent}{color.Yellow("<- {name}")} {color.Dim(strpkg.Truncate(result, resultWidth))}",
        )
